{
  "name": "lc-review",
  "version": "0.0.11",
  "description": "LeetCode flashcards for spaced repetition learning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayakovlenko/lc-review.git"
  },
  "homepage": "https://github.com/ayakovlenko/lc-review",
  "issues": {
    "url": "https://github.com/ayakovlenko/lc-review/issues"
  },
  "main": "dist/index.mjs",
  "files": [
    "dist/index.mjs",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "fmt": "npx prettier --write .",
    "lc-review": "node ./dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "leetcode",
    "spaced-repetition",
    "cli"
  ],
  "author": "Anton Iacovlenco",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "25.0.6",
    "tsdown": "0.19.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "@toon-format/toon": "2.1.0",
    "supermemo": "2.0.23",
    "zod": "4.3.5"
  },
  "bin": {
    "lc-review": "dist/index.mjs"
  }
}
